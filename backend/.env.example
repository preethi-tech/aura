# Copy to .env and fill in to enable Gemini. Everything is optional:
# with no key, Aura uses a fully offline deterministic analyzer.

# Google AI Studio API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional overrides
# AURA_DB_PATH=./aura.db
# AURA_HOST=127.0.0.1
# AURA_PORT=8000
# AURA_USER=local
