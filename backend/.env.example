# Copy to .env and fill in to enable features. Everything is optional:
# with no keys, Aura uses fully offline deterministic analysis + SQLite.

# Google AI Studio API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Firebase (optional) -- enables Firestore cloud storage + user auth
# Get from: Firebase Console > Project Settings > General
FIREBASE_PROJECT_ID=
# Path to service account JSON (local only; Cloud Run uses ADC)
# GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json
# Web API key for Firebase Auth (from Firebase Console > Project Settings > General > Your apps)
FIREBASE_WEB_API_KEY=

# Storage backend: "firestore" or "sqlite" (auto-detects from FIREBASE_PROJECT_ID)
# STORAGE_BACKEND=

# Cloud Logging (optional) -- routes logs to Google Cloud Logging
# CLOUD_LOGGING_ENABLED=true

# BigQuery analytics (optional; exports only after explicit user consent)
# BIGQUERY_ENABLED=true
# BIGQUERY_PROJECT_ID=your-gcp-project-id
# BIGQUERY_DATASET=aura_analytics
# BIGQUERY_TABLE=daily_signals
# BIGQUERY_LOCATION=US
# BIGQUERY_MAX_BYTES_BILLED=100000000
# Store a random value in Secret Manager for Cloud Run; do not commit it.
# BIGQUERY_PSEUDONYM_SALT=

# Optional overrides
# AURA_DB_PATH=./aura.db
# AURA_HOST=127.0.0.1
# AURA_PORT=8000
# AURA_USER=local
